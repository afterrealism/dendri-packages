exports[`Wire Protocol Snapshots > RPC request format > matches expected shape 1`] = `"{"__rpc":true,"id":"rpc_1_1234567890","method":"getScore","payload":{"level":1},"sender":"peer-abc"}"`;

exports[`Wire Protocol Snapshots > RPC response format > error matches expected shape 1`] = `"{"__rpc_response":true,"id":"rpc_1_1234567890","error":{"code":1505,"message":"Method not found: foo"}}"`;

exports[`Wire Protocol Snapshots > RPC response format > success matches expected shape 1`] = `"{"__rpc_response":true,"id":"rpc_1_1234567890","result":{"score":42}}"`;

