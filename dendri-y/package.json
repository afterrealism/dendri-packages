{
	"name": "@afterrealism/dendri-y",
	"version": "0.1.1",
	"type": "module",
	"packageManager": "pnpm@10.30.1",
	"description": "Yjs CRDT provider on top of Dendri P2P rooms",
	"keywords": [
		"yjs",
		"crdt",
		"dendri",
		"webrtc",
		"p2p",
		"collaboration"
	],
	"homepage": "https://dendri.dev",
	"bugs": {
		"url": "https://github.com/afterrealism/dendri-packages/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/afterrealism/dendri-packages.git",
		"directory": "dendri-y"
	},
	"license": "Apache-2.0",
	"main": "./dist/dendri-y.cjs",
	"module": "./dist/dendri-y.js",
	"types": "./dist/dendri-y.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/dendri-y.d.ts",
				"default": "./dist/dendri-y.js"
			},
			"require": {
				"types": "./dist/dendri-y.d.cts",
				"default": "./dist/dendri-y.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsup",
		"build:watch": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build",
		"clean": "rm -rf dist"
	},
	"peerDependencies": {
		"y-protocols": "^1.0.0",
		"yjs": "^13.6.0",
		"@afterrealism/dendri-client": "^2.3.7"
	},
	"devDependencies": {
		"@afterrealism/dendri-client": "file:../dendri-client",
		"tsup": "^8.0.0",
		"typescript": "^5.7.0",
		"vitest": "^3.1.1",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.30"
	}
}
